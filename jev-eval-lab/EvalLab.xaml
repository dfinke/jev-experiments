<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jev Eval Lab" Width="1180" Height="760" MinWidth="1000" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="#10151B" Foreground="#F1F4EE" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#1C2731"/><Setter Property="Foreground" Value="#F1F4EE"/><Setter Property="BorderBrush" Value="#405248"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,9"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="AcceptsReturn" Value="True"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="CaretBrush" Value="#B7F36B"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#1C2731"/><Setter Property="Foreground" Value="#F1F4EE"/><Setter Property="BorderBrush" Value="#405248"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><Grid><ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/><ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Width="32"><Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#B7F36B" HorizontalAlignment="Center" VerticalAlignment="Center"/></ToggleButton></Grid></Border><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#1C2731" BorderBrush="#405248" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#1C2731"/><Setter Property="Foreground" Value="#F1F4EE"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#202B34"/><Setter Property="Foreground" Value="#DCE5E8"/><Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#43554D" CornerRadius="4" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
    <DataTemplate x:Key="GaugeRow"><Border Background="#1B252D" CornerRadius="8" Padding="13,10" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Level}" Foreground="#B7F36B" FontFamily="Consolas" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="8,0,8,0"/><TextBlock Grid.Column="2" Text="{Binding PercentLabel}" HorizontalAlignment="Right" Foreground="#B7F36B" FontFamily="Consolas"/><ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="6" Value="{Binding Percent}" Maximum="100" Background="#304136" Foreground="#B7F36B" BorderThickness="0" Margin="0,8,0,0"/></Grid></Border></DataTemplate>
  </Window.Resources>
  <Grid Margin="30,22,30,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel Orientation="Horizontal"><Grid Width="32" Height="32" Margin="0,0,12,0"><Ellipse Stroke="#B7F36B" StrokeThickness="2"/><Ellipse Width="12" Height="12" Fill="#B7F36B"/></Grid><TextBlock Text="JEV EVAL LAB" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/><TextBlock Text="/ TYPED JUDGMENTS" Foreground="#778995" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11"/></StackPanel><Border HorizontalAlignment="Right" Background="#203327" CornerRadius="12" Padding="12,6"><TextBlock x:Name="Mode" Text="LIVE JEV" Foreground="#B7F36B" FontSize="11" FontWeight="SemiBold"/></Border></Grid>
    <Grid Grid.Row="1" Margin="0,21,0,18"><StackPanel><TextBlock Text="Turn an answer into a measurable judgment." FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Define the question. Describe the levels. Watch Jev score the answer." Foreground="#8F9FAA" FontSize="14" Margin="0,7,0,0"/></StackPanel><TextBlock x:Name="ModelLabel" Text="System One / Score" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#B7F36B" FontFamily="Consolas" FontSize="11"/></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="470"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#161E25" CornerRadius="12" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="01 / DEFINE THE EVAL" FontSize="11" FontWeight="SemiBold" Foreground="#93A5B2"/><StackPanel Grid.Row="1"><TextBlock Text="Try an example" FontSize="12" Foreground="#C5D0D5" Margin="0,13,0,0"/><ComboBox x:Name="ExamplePicker"/></StackPanel>
        <TextBlock Grid.Row="2" Text="Question" FontSize="12" Foreground="#C5D0D5" Margin="0,13,0,0"/><TextBox x:Name="Question" Grid.Row="3" Height="56" VerticalScrollBarVisibility="Disabled"/>
        <TextBlock Grid.Row="4" Text="Answer" FontSize="12" Foreground="#C5D0D5" Margin="0,13,0,0"/><TextBox x:Name="Answer" Grid.Row="5" Height="92"/>
        <StackPanel Grid.Row="6"><TextBlock Text="Rubric levels (low → high)" FontSize="12" Foreground="#C5D0D5" Margin="0,13,0,0"/><TextBox x:Name="Level0" Height="48" AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"/><TextBox x:Name="Level1" Height="48" AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"/><TextBox x:Name="Level2" Height="48" AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"/><TextBox x:Name="Level3" Height="48" AcceptsReturn="False" TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled" VerticalContentAlignment="Center"/><Button x:Name="Evaluate" Content="Evaluate with Jev  ↵" Background="#B7F36B" Foreground="#142014" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Stretch" Margin="0,13,0,0"/></StackPanel>
      </Grid></ScrollViewer></Border>
      <Border Grid.Column="2" Background="#17221F" BorderBrush="#304337" BorderThickness="1" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><TextBlock Text="02 / READ THE DISTRIBUTION" FontSize="11" FontWeight="SemiBold" Foreground="#B7F36B"/><TextBlock x:Name="Working" Text="READY" HorizontalAlignment="Right" Foreground="#8FAD89" FontSize="10"/></Grid>
        <Grid Grid.Row="1" Margin="0,13,0,15"><StackPanel><TextBlock x:Name="ScoreLabel" Text="—" FontSize="42" FontWeight="SemiBold" Foreground="#B7F36B"/><TextBlock x:Name="ScoreSub" Text="Enter an answer and press Evaluate." Foreground="#99B29D" FontSize="12" Margin="0,2,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ConfidenceLabel" Text="CONFIDENCE  —" FontFamily="Consolas" Foreground="#C3D4C3" FontSize="12" HorizontalAlignment="Right"/><TextBlock x:Name="LatencyLabel" Text="ROUND TRIP  —" FontFamily="Consolas" Foreground="#8CA38F" FontSize="11" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel></Grid>
        <Border Grid.Row="2" Background="#202F28" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="TopLevelLabel" Text="TOP LEVEL  —" FontSize="11" Foreground="#C3D4C3"/><TextBlock x:Name="ScoreRangeLabel" Grid.Column="1" Text="RANGE  0–3" FontSize="11" Foreground="#C3D4C3"/><TextBlock x:Name="CallLabel" Grid.Column="2" Text="CALLS  0" FontSize="11" Foreground="#C3D4C3" HorizontalAlignment="Right"/></Grid></Border>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Gauges" ItemTemplate="{StaticResource GaugeRow}"/></ScrollViewer>
        <TextBlock Grid.Row="4" x:Name="Status" Text="Jev returns a score, confidence, and a probability for every level." Foreground="#8CA38F" FontSize="11" Margin="0,12,0,0"/>
      </Grid></Border>
    </Grid>
    <Grid Grid.Row="3" Margin="0,14,0,0"><TextBlock Text="STATE → SCORE → PROBABILITIES → CODE DECIDES" Foreground="#617581" FontSize="10"/><TextBlock x:Name="Footer" Text="Raw answer is sent only to the TypeSafe API when you press Evaluate." HorizontalAlignment="Right" Foreground="#617581" FontSize="10"/></Grid>
  </Grid>
</Window>
